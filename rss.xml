---
layout: null
---
{%- capture records -%}
{%- for file in site.static_files -%}
{%- if file.extname == '.html' and file.name == 'index.html' -%}
{%- assign include_path = file.path | remove_first: '/' -%}
{%- capture source -%}{%- include_relative {{ include_path }} -%}{%- endcapture -%}
{%- if source contains 'property="article:published_time"' and source contains '<div class="article-body">' -%}
{%- assign modified = source | split: 'property="article:modified_time" content="' | last | split: '"' | first -%}
{{- modified -}}|{{- include_path -}}||
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endcapture -%}
{%- assign ordered = records | split: '||' | sort | reverse -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
<title>그루밍노트 최신 게시물</title>
<link>https://groomingnote.co.kr/</link>
<description>반려견 미용·홈케어·견종별 관리·자격증과 지역별 학원 가이드</description>
<language>ko-KR</language>
<atom:link href="https://groomingnote.co.kr/rss.xml" rel="self" type="application/rss+xml"/>
{%- for record in ordered limit:20 -%}
{%- if record contains '|' -%}
{%- assign include_path = record | split: '|' | last -%}
{%- capture source -%}{%- include_relative {{ include_path }} -%}{%- endcapture -%}
{%- assign title = source | split: '<title>' | last | split: '</title>' | first -%}
{%- assign canonical = source | split: 'rel="canonical" href="' | last | split: '"' | first -%}
{%- assign published = source | split: 'property="article:published_time" content="' | last | split: '"' | first -%}
{%- assign article = source | split: '<div class="article-body">' | last | split: '    </div>
  </div>
</section>' | first -%}
{%- assign article = article | replace: 'href="/', 'href="https://groomingnote.co.kr/' | replace: 'src="/', 'src="https://groomingnote.co.kr/' -%}
<item>
<title>{{ title | xml_escape }}</title>
<link>{{ canonical | xml_escape }}</link>
<guid isPermaLink="true">{{ canonical | xml_escape }}</guid>
<pubDate>{{ published | append: 'T00:00:00+09:00' | date_to_rfc822 }}</pubDate>
<description>{{ article | xml_escape }}</description>
</item>
{%- endif -%}
{%- endfor -%}
</channel>
</rss>
